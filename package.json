{
  "name": "astral-wish-lab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "npm@10.9.0",
  "engines": {
    "node": ">=22.12.0 <23 || >=24"
  },
  "scripts": {
    "dev": "vite",
    "seo:generate": "node scripts/generate-character-pages.mjs",
    "build": "npm run seo:generate && VITE_SITE_URL=http://localhost:4173/ tsc -b && VITE_SITE_URL=http://localhost:4173/ vite build && VITE_SITE_URL=http://localhost:4173/ node scripts/finalize-production.mjs --allow-localhost",
    "build:production": "npm run seo:generate && node scripts/validate-production.mjs && tsc -b && vite build && node scripts/finalize-production.mjs",
    "lint": "eslint .",
    "seo:check": "node scripts/check-seo.mjs",
    "test": "vitest run",
    "typecheck": "tsc -b --pretty false",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.4",
    "@eslint/js": "^9.36.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "globals": "^16.4.0",
    "jsdom": "^26.1.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.45.0",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  }
}
